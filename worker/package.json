{
  "name": "soccer-carpool-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Club-scale carpool API: multi-tenant roster, ride matching and route optimization.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev",
    "db:local": "wrangler d1 execute carpool --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute carpool --local --file=./seed.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
